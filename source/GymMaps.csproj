<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>GymMaps</AssemblyName>
    <Version>1.5.0</Version>
    <LangVersion>latest</LangVersion>
    <GameRoot Condition="'$(GameRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RUMBLE</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="DefaultMaps\*.txt">
      <LogicalName>GymMaps.DefaultMaps.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Reference Include="0Harmony"><HintPath>$(GameRoot)\MelonLoader\net6\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MelonLoader"><HintPath>$(GameRoot)\MelonLoader\net6\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(GameRoot)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RumbleModdingAPI"><HintPath>$(GameRoot)\Mods\RumbleModdingAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UIFramework"><HintPath>$(GameRoot)\Mods\UIFramework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(GameRoot)\MelonLoader\Il2CppAssemblies\*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
