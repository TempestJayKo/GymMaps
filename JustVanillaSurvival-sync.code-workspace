{
  "folders": [
    {
      "path": "."
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "JVS: Install dependency",
        "type": "process",
       "command": "C:\\Users\\colli\\.local\\bin\\python3.14.exe",
"args": ["${workspaceFolder}/tools/install.py"],
        "problemMatcher": []
      },
      {
        "label": "JVS: Setup connection",
        "type": "process",
        "command": "${workspaceFolder}/.jvs-sync/venv/Scripts/python.exe",
        "args": [
          "${workspaceFolder}/tools/jvs_sync.py",
          "setup"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "presentation": {
          "reveal": "always",
          "focus": true,
          "panel": "dedicated"
        },
        "problemMatcher": []
      },
      {
        "label": "JVS: Download settings and data",
        "type": "process",
        "command": "${workspaceFolder}/.jvs-sync/venv/Scripts/python.exe",
        "args": [
          "${workspaceFolder}/tools/jvs_sync.py",
          "download"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "presentation": {
          "reveal": "always",
          "focus": true,
          "panel": "dedicated"
        },
        "problemMatcher": []
      },
      {
        "label": "JVS: Upload settings and data",
        "type": "process",
        "command": "${workspaceFolder}/.jvs-sync/venv/Scripts/python.exe",
        "args": [
          "${workspaceFolder}/tools/jvs_sync.py",
          "upload"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "presentation": {
          "reveal": "always",
          "focus": true,
          "panel": "dedicated"
        },
        "problemMatcher": []
      }
    ]
  }
}